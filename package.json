{
  "devDependencies": {
    "@babel/cli": "7.0.0-beta.44",
    "@babel/core": "7.0.0-beta.44",
    "@babel/preset-env": "7.0.0-beta.44",
    "@types/google-apps-script": "^0.0.23",
    "babel-plugin-array-includes": "^2.0.3",
    "babel-preset-gas": "^1.0.1",
    "eslint": "^4.19.1",
    "eslint-plugin-googleappsscript": "^1.0.1",
    "webpack": "^4.12.0",
    "webpack-cli": "^3.0.3"
  },
  "scripts": {
    "prebuild": "eslint ./src/**/*.js",
    "build": "babel src -d dist --copy-files --include-dotfiles",
    "postbuild": "cp -R ./clasp/ dist && cd dist && clasp push"
  },
  "babel": {
    "presets": [
      ["@babel/preset-env", {
        "targets": "chrome"
      }],
      "gas"
    ],
    "plugins": [
      "array-includes"
    ]
  },
  "license": "MIT"
}
