{
  "devDependencies": {
    "@types/google-apps-script": "^0.0.23",
    "babel-core": "^6.26.3",
    "babel-loader": "^7.1.4",
    "babel-plugin-array-includes": "^2.0.3",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "babel-preset-env": "^1.7.0",
    "eslint": "^4.19.1",
    "eslint-plugin-googleappsscript": "^1.0.1",
    "gas-webpack-plugin": "^0.3.0",
    "renamer": "^0.7.0",
    "webpack": "^4.12.0",
    "webpack-cli": "^3.0.3"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "webpack",
    "postbuild": "yarn clasp",

    "preclasp": "renamer --find 'gs' --replace 'js' ./dist/*.gs",
    "clasp": "cp -R ./clasp/ dist && cd dist && clasp push",

    "watch": "webpack -w"
  },
  "babel": {
    "presets": [
      [
        "env"
      ]
    ],
    "plugins": [
      "array-includes",
      "transform-class-properties"
    ]
  },
  "license": "MIT"
}
