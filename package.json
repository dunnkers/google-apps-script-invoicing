{
  "devDependencies": {
    "@babel/cli": "7.0.0-beta.44",
    "@babel/core": "7.0.0-beta.44",
    "@babel/preset-env": "7.0.0-beta.44",
    "@types/google-apps-script": "^0.0.23",
    "babel-plugin-array-includes": "^2.0.3",
    "eslint": "^4.19.1",
    "webpack": "^4.12.0",
    "webpack-cli": "^3.0.3"
  },
  "scripts": {
    "babel": "babel src -d dist --copy-files --include-dotfiles",

    "webpack": "webpack --mode development --config webpack.config.js",
    "postwebpack": "cp -R ./clasp/ dist",

    "prebuild": "eslint ./src/**/*.js",
    "build": "npm run babel",
    "postbuild": "cp -R ./clasp/ dist && cd dist && clasp push"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ],
    "plugins": [
      "array-includes"
    ]
  },
  "license": "MIT"
}
